{
  "name": "fine-tuner",
  "version": "0.0.0",
  "description": "The fine-tuner monorepo",
  "private": "true",
  "scripts": {
    "generate-dataset": "pnpm --filter=fine-tuner-core run generate-dataset",
    "convert-to-gguf": "pnpm --filter=fine-tuner-core run convert-to-gguf",
    "check:lite": "pnpm run type-check && pnpm run prettier && pnpm run jscpd",
    "jscpd": "jscpd .",
    "prettier": "prettier --check .",
    "prettier:write": "prettier --write .",
    "type-check": "tsc --build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "https://github.com/sdev-buildz",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.20.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "jscpd": "^5.4.3",
    "prettier": "^3.10.1",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
