# Path to the repo on which the model is to be fine-tuned
REPO_PATH=../target-repo

# Path to the llama.cpp repository or installation directory
LLAMA_CPP_PATH=../llama-cpp

# Folder containing the PEFT LoRA adapter config and safetensors weights
LORA_SAFE_TENSORS_PATH=generated/qwen_1.5b_lora

# Folder in which the converted GGUF adapter is written
LORA_GGUF_PATH=generated/lora-gguf

# Hugging Face access token required by llama.cpp to fetch the base model configuration.
HF_TOKEN=your-hugging-face-read-token
